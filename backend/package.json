{
  "name": "backend",
  "version": "1.0.0",
  "description": "API for Distributed Job Scheduler",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:concurrency": "vitest run test/concurrency",
    "load:smoke": "docker run --rm -v $PWD/test/load:/test -w /test -e API_URL=http://host.docker.internal:3000/api/v1 grafana/k6 run smoke.js",
    "load:api": "docker run --rm -v $PWD/test/load:/test -w /test -e API_URL=http://host.docker.internal:3000/api/v1 grafana/k6 run api.js",
    "load:enqueue": "docker run --rm -v $PWD/test/load:/test -w /test -e API_URL=http://host.docker.internal:3000/api/v1 grafana/k6 run enqueue.js",
    "load:worker": "docker run --rm -v $PWD/test/load:/test -w /test -e API_URL=http://host.docker.internal:3000/api/v1 grafana/k6 run worker.js",
    "load:stress": "docker run --rm -v $PWD/test/load:/test -w /test -e API_URL=http://host.docker.internal:3000/api/v1 grafana/k6 run stress.js",
    "load:soak": "docker run --rm -v $PWD/test/load:/test -w /test -e API_URL=http://host.docker.internal:3000/api/v1 grafana/k6 run soak-short.js",
    "load:report": "node test/load/generate-report.js",
    "test": "vitest",
    "lint": "eslint src/**/*.ts",
    "openapi:validate": "redocly lint docs/api/openapi.yaml"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@prisma/client": "^5.10.2",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.6",
    "cron-parser": "^4.9.0",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^7.2.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.3",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "pino-pretty": "^11.3.0",
    "prom-client": "^15.1.3",
    "shared": "file:../shared",
    "swagger-parser": "^10.0.3",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^8.3.2",
    "yaml": "^2.9.0",
    "yamljs": "^0.3.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@redocly/cli": "^2.39.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@types/yaml": "^1.9.6",
    "@types/yamljs": "^0.2.34",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "vitest": "^1.6.1"
  }
}
