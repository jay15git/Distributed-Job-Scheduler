# Environment (development, test, production)
NODE_ENV=development

# Role determines the startup behavior (api, worker, scheduler, migrate)
ROLE=api

# Port for API server
PORT=3000

# PostgreSQL Configuration
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/djs?schema=public"

# Redis Configuration
REDIS_URL="redis://redis:6379"

# JWT Secret for API Authentication
JWT_SECRET="supersecret_change_me_in_production"

# Observability / Metadata
GIT_COMMIT="unknown"
BUILD_TIME="unknown"
